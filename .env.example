# Copy to .env.local only when you are ready to make paid OpenAI requests.
# Server only: never use NEXT_PUBLIC_ for these variables.
# Empty key keeps the offline demo. A non-empty key enables paid requests after restart.
OPENAI_API_KEY=
# Optional; defaults to gpt-5.4-mini. Choose a model supporting Responses + Structured Outputs.
OPENAI_MODEL=gpt-5.4-mini
